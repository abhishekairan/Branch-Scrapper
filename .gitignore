# Local Python env (never global Python)
.venv/
__pycache__/
*.pyc

# Scrape results and per-user settings
output/
config.json

# SeleniumBase runtime files and Chrome profiles
downloaded_files/
latest_logs/
archived_logs/
chrome_profile*/

# Spike outputs (saved pages, screenshots, measurements)
spikes/out/

# Packaging outputs (PyInstaller work/dist, staged sidecar, installers)
build/
dist/
app/src-tauri/sidecar/*
!app/src-tauri/sidecar/README.txt

# Desktop app (Tauri + Svelte)
app/node_modules/
app/dist/
app/src-tauri/target/

# Promo video render outputs and frame temp dirs (see marketing/video/render.py)
marketing/out/
# Private launch copy (not part of the project)
marketing/posts.md
marketing/**/frames/
marketing/**/_frames/
